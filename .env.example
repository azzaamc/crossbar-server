# Crossbar server configuration.
#
# Copy to .env and edit. `.env` is never committed; this template is.
#
# The listener may only ever be loopback: in private mode identity is a header
# injected by the local Tailscale proxy, in public mode a reverse proxy on this same
# host terminates TLS and forwards here, and neither is trustworthy if anything else
# can reach the port.

HOST=127.0.0.1
PORT=3003

# ── Which configuration is in force ─────────────────────────────────────────────
#
# A deployment holds both. `private` is the tailnet: a local proxy injects an identity
# header, and the loopback listener is what makes that header mean anything. `public`
# is the open internet behind a reverse proxy on this same host: nothing in a request
# is believed, and a device proves itself with a key it holds.
#
# Fill in a block for each mode this deployment can be reached in, then switch with
# `node src/admin.js mode private|public`. That rewrites the section marked below and
# nothing else — the secrets, paths, limits and relay settings in between are never
# touched by switching — and a mode whose block is not filled in is refused, leaving
# the file exactly as it was. `node src/admin.js mode` shows both, and which is in
# force.
#
# The origin has to be the address clients actually reach: an invitation carries it,
# and naming a host that does not answer fails at the worst moment — mid-call.

# The tailnet, as today.
NETWORK_MODE_PRIVATE_HOSTNAME=
NETWORK_MODE_PRIVATE_ORIGIN=

# The open internet. The hostname is required in this mode, and has to be the host in
# the origin. The bind address is the one the reverse proxy listens on — Caddy reads
# it, not the server — and the wildcard looks right and is not: a host that already
# runs Tailscale holds the port on its own address. See deploy/README.md.
NETWORK_MODE_PUBLIC_HOSTNAME=
NETWORK_MODE_PUBLIC_ORIGIN=
NETWORK_MODE_PUBLIC_BIND_ADDRESS=

# >>> the configuration in force, written by `node src/admin.js mode` >>>
CROSSBAR_NETWORK_MODE=private
CROSSBAR_PUBLIC_HOSTNAME=
PUBLIC_ORIGIN=
CROSSBAR_BIND_ADDRESS=
# Left empty on purpose: the mode decides both. The identity header is believed
# only in private mode, and device keys are required only in public.
TRUST_TAILSCALE_HEADERS=
CROSSBAR_REQUIRE_DEVICE_AUTH=
# <<< end of the configuration in force <<<

DATA_DIR=/home/admin/crossbar/data
DIRECTORY_CONFIG_PATH=/home/admin/crossbar/data/directory.json

# Where the directory PWA's static files are. The Crossbar server serves them so
# the PWA talks to this API on its own origin. Point this at the server's own
# `public/` once the PWA files live in this project.
WEB_ROOT=/home/admin/crossbar/public

# Identity. The proxy injects `Tailscale-User-Login` and the server accepts it only
# from loopback. Private mode believes it; public mode must not, because there the same
# header is one a stranger can type, which is why the reverse proxy strips it. What a
# mode trusts is not something a stray line should be able to contradict, so the switch
# owns this one and writes it empty: the mode decides.

# Who becomes a member. On (the default, and what the service this replaces does):
# a login that arrives from the tailnet is enrolled on first contact, so the
# tailnet is the perimeter. Off: only logins already present in the directory
# file are accepted.
AUTO_ENROL_IDENTITIES=true

# Development identity: a laptop stand-in for the proxy, for when no tailnet is
# present. Leave both unset in any deployment — the server refuses to start with
# dev identity enabled on a non-loopback listener, but there is no reason to
# find out.
ALLOW_DEV_IDENTITY=false
DEV_IDENTITIES=

# Crossbar's own device identity: a key per device, enrolled once, and used to answer
# a challenge. This is the application's authentication in both modes; the tailnet
# header is an additional trust signal where it exists, never the thing that decides
# who someone is.
#
# On by default in public mode, where being reachable means nothing at all, and off by
# default in private mode, because the devices that exist today have no key yet and
# turning it on stops them connecting. The switch owns this one too, and leaves it to
# the mode; a device holding a key is still recognised either way.

# The console's own password. The console is an operator surface, not a client, and this is
# how whoever runs the directory reaches it from a browser that has enrolled no device key.
# Set it with `node src/admin.js password`, which hashes it: the password itself is never
# written anywhere, here or in the database. Unset, the console is reachable only from a
# device that has already enrolled.
CROSSBAR_ADMIN_PASSWORD_HASH=

# Signs session tokens, so it must be a real secret and it has to stay put: replacing
# it signs every device out. Generate one with `openssl rand -hex 32`. Required
# whenever device auth is on.
CROSSBAR_SESSION_SECRET=
CROSSBAR_SESSION_TTL_SECONDS=43200
CROSSBAR_CHALLENGE_TTL_SECONDS=120
# How long an enrollment invitation stays usable.
CROSSBAR_ENROLLMENT_TTL_SECONDS=900

# Media. STUN only by default; TURN requires an explicit decision about who
# relays the media of the people in the directory.
ICE_STUN_URL=stun:stun.l.google.com:19302
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=

# Relaying through coturn, for a deployment whose devices cannot always reach each other
# directly. Setting CROSSBAR_TURN_HOST switches the ICE list from the fixed one above to
# per-device TURN credentials, so the static ICE_TURN_* entries are only needed for a
# relay somebody else runs.
#
# The shared secret is coturn's `static-auth-secret` (see deploy/coturn.conf). It never
# reaches a client: clients are handed a username carrying its own expiry and a password
# derived from it, which is why the same value has to be on both sides and why it belongs
# here rather than in a device.
#
# Host and secret have to be set together; a host without a secret is refused at start-up
# rather than silently serving a relay that rejects everyone.
CROSSBAR_TURN_HOST=

# The address the relay tells clients to use, written as `PUBLIC_IPV4/LAN_IPV4`. A host
# behind NAT needs it, or the relay hands out an address on the private network that
# nobody outside can reach; a host with a public address of its own leaves it empty, and
# the unit drops the line rather than passing coturn an option with nothing after it.
# A residential address moves — when it does, this goes stale silently. See deploy/README.md.
CROSSBAR_TURN_EXTERNAL_IP=
CROSSBAR_TURN_PORT=3478
# The relay port range. Every relayed session occupies one port from it, so this is also
# the range the router has to forward — 1:1, without remapping — and the range the
# firewall has to allow.
CROSSBAR_TURN_MIN_PORT=49160
CROSSBAR_TURN_MAX_PORT=49200
CROSSBAR_TURN_SHARED_SECRET=
# How long a client's relay credential stays valid.
CROSSBAR_TURN_TTL_SECONDS=600

MAX_PARTICIPANTS=4
CALL_RING_SECONDS=90

# Ringing your own other devices — the phone ringing the laptop. Useful when every
# device on the tailnet presents the same identity, which is the case when one
# person owns them all, and it is also the only way to test a call between two
# devices of one person. Off: inviting yourself is refused.
ALLOW_SELF_CALLS=false

# Web Push for browser clients. Absent keys mean the capability reports itself
# disabled rather than failing at the moment a call arrives.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# APNs, for telling somebody about a call they missed. Ringing a phone is not this key's
# job any more — a call wake goes through the push relay below — but the missed-call
# notification still does, because the relay is a VoIP-only transport and a missed call is
# a line on a lock screen rather than a ring. Without this key, a missed call is silent
# while everything else keeps working.
#
# The key is an "Apple Push Notifications service (APNs)" key from the developer
# account, downloaded once as a .p8 and kept out of this file — put it somewhere the
# service can read, mode 0600, and name it here. CROSSBAR_APNS_TOPIC is the app's
# bundle id.
CROSSBAR_APNS_KEY_ID=
CROSSBAR_APNS_TEAM_ID=
CROSSBAR_APNS_KEY_PATH=
CROSSBAR_APNS_TOPIC=

# The Crossbar Push Relay, which rings a phone whose screen is off. A suspended iOS app is
# woken by nothing except a VoIP push, and Apple's signing key for the shared app is held
# centrally instead of by every deployment: this server registers each phone's VoIP token
# with the relay and posts a call wake there. The relay knows nothing but the installation,
# a device id and a token — no users, no calls, no media (relay docs/BACKEND_INTEGRATION.md).
#
# A relay's operator runs `node scripts/relay-admin.mjs create --label "…"` and hands over the
# three settings below, in the names it prints — that is the route for a relay you run, or when
# the shared relay is not taking new installations. A deployment with no operator obtains its
# own the same way during setup, with the three values the wizard writes below.
#
# The setup wizard offers three ways to get these: the shared relay at
# https://crossbar-push-dev.ibnfaisalc.workers.dev — the default, which enrols this deployment
# by itself with one unauthenticated request to the relay's `POST /v1/installations` and writes
# all three settings below; another relay, whose URL and credential you already have; or no
# relay at all. Nobody pastes a credential to take the default, and the summary says which
# relay is in force and whether its credential was obtained automatically or given.
#
# CROSSBAR_PUSH_RELAY_TOKEN is a server secret: it never reaches a phone, never appears in a
# payload or a log line, and is shown once, so keep it in this file (mode 0600) rather than in a
# command line or a repository. Losing it means a rotation, not a recovery.
#
# Set all of URL and TOKEN or the ring transport is disabled and says so in the journal —
# a locked phone then simply never rings while the missed-call alert keeps working.
#
# The URL must be `https:` — the installation credential travels on every request and a
# plaintext relay would expose it — unless the host is loopback, which is the one place an
# unencrypted relay is allowed (a local one). Anything else is refused with the scheme named.
CROSSBAR_PUSH_RELAY_URL=
CROSSBAR_PUSH_RELAY_TOKEN=
# The relay's id for this installation, `ins_…`. Nothing sends it: the credential is what
# names the installation. It is kept so a refusal can be logged against the installation it
# belongs to.
CROSSBAR_PUSH_RELAY_INSTALLATION_ID=
# How long one request to the relay may take. A ring that arrives late is worth less than
# one that does not arrive, so this is finite and short; a relay that answers more slowly
# than this is a relay with a problem.
CROSSBAR_PUSH_RELAY_TIMEOUT_MS=5000

NODE_ENV=production
